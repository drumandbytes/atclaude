# Template for the formula that release.yml writes to drumandbytes/homebrew-tap.
class Atclaude < Formula
  desc "Inline shell companion for Claude Code with encrypted, searchable history"
  homepage "https://atclaude.drumandbytes.dev"
  version "@VERSION@"
  license "MIT"

  on_macos do
    on_arm do
      url "https://github.com/drumandbytes/atclaude/releases/download/@TAG@/atclaude_darwin_arm64.tar.gz"
      sha256 "@SHA_DARWIN_ARM64@"
    end
    on_intel do
      url "https://github.com/drumandbytes/atclaude/releases/download/@TAG@/atclaude_darwin_amd64.tar.gz"
      sha256 "@SHA_DARWIN_AMD64@"
    end
  end

  on_linux do
    on_arm do
      url "https://github.com/drumandbytes/atclaude/releases/download/@TAG@/atclaude_linux_arm64.tar.gz"
      sha256 "@SHA_LINUX_ARM64@"
    end
    on_intel do
      url "https://github.com/drumandbytes/atclaude/releases/download/@TAG@/atclaude_linux_amd64.tar.gz"
      sha256 "@SHA_LINUX_AMD64@"
    end
  end

  def install
    bin.install "atclaude"
  end

  def caveats
    <<~EOS
      Add the shell integration to your shell's startup file, for zsh:
        eval "$(atclaude init zsh)"
      Other shells and the full setup: https://atclaude.drumandbytes.dev
    EOS
  end

  test do
    assert_match version.to_s, shell_output("#{bin}/atclaude --version")
  end
end
